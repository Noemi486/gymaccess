# Plantilla del entorno de PRUEBAS. Cópiala como backend/.env.test y completa DB_PASSWORD.
# El archivo .env.test NO se sube al repositorio.
# Las pruebas usan SIEMPRE la base gymaccess_test, nunca gymaccess.
# La base se crea con database/scripts/crear-bd-pruebas.sql (ejecutado como root).

DB_HOST=localhost
DB_PORT=3306
DB_USER=gymaccess_app
DB_PASSWORD=
DB_NAME=gymaccess_test

# Secreto propio de las pruebas (distinto del de desarrollo; mínimo 16 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=8h

PORT=3001
CORS_ORIGIN=http://localhost:5173

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Clave para cifrar los descriptores faciales (AES-256-GCM): 64 caracteres hexadecimales (32 bytes).
# Genérala con: node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
# Si se pierde, los rostros guardados no se pueden descifrar y hay que registrarlos de nuevo.
# Usa una clave distinta en .env y en .env.test. NO la subas al repositorio.
FACE_KEY=
