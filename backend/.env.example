# Copia este archivo como backend/.env y completa los valores reales.
# El archivo .env NO se sube al repositorio.

# Conexión a MySQL (base gymaccess ya creada). Usar el usuario gymaccess_app, nunca root.
DB_HOST=localhost
DB_PORT=3306
DB_USER=gymaccess_app
DB_PASSWORD=
DB_NAME=gymaccess

# Autenticación (JWT)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Bloqueo por intentos fallidos de inicio de sesión
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Solo para database/scripts/crear-admin.js (administrador inicial)
ADMIN_EMAIL=
ADMIN_NOMBRE=
ADMIN_PASSWORD=

# Clave para cifrar los descriptores faciales (AES-256-GCM): 64 caracteres hexadecimales (32 bytes).
# Genérala con: node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
# Si se pierde, los rostros guardados no se pueden descifrar y hay que registrarlos de nuevo.
# Usa una clave distinta en .env y en .env.test. NO la subas al repositorio.
FACE_KEY=
