# Variables de entorno del proyecto GymAccess (plantilla SIN valores reales).
# Las variables que usa el servidor están documentadas en backend/.env.example.
# Crea backend/.env a partir de esa plantilla; el archivo .env nunca se sube al repositorio.

DB_HOST=localhost
DB_PORT=3306
DB_USER=gymaccess_app
DB_PASSWORD=
DB_NAME=gymaccess

JWT_SECRET=
JWT_EXPIRES_IN=8h

PORT=3000
CORS_ORIGIN=http://localhost:5173

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

ADMIN_EMAIL=
ADMIN_NOMBRE=
ADMIN_PASSWORD=
